# Телеграм-бот
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Опционально: при первом запуске бот автоматически подпишет этот чат на рассылку.
# В дальнейшем подписка управляется через кнопку в боте (/menu → 🔔 Подписаться).
# CHAT_ID=123456789

# Wildberries API (опционально — для автомиграции первого магазина)
